# EmailJS Configuration for Portfolio Contact Form
# Get these credentials by creating a free account at https://www.emailjs.com/
# 1. Create an Email Service (e.g. Gmail) -> Copy Service ID
# 2. Create an Email Template -> Copy Template ID
# 3. Go to Account > API Keys -> Copy Public Key

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
